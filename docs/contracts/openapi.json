            "type": "string",
            "title": "Keyword"
          },
          "status": {
            "type": "string",
            "title": "Status",
            "default": "completed"
          },
          "output_dir": {
            "type": "string",
            "title": "Output Dir"
          },
          "files": {
            "additionalProperties": {
