      "BriefingRequest": {
        "properties": {
          "keyword": {
            "type": "string",
            "maxLength": 100,
            "minLength": 2,
            "title": "Keyword",
            "description": "SEO keyword to generate briefing for (2-100 chars)"
          },
          "target_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
