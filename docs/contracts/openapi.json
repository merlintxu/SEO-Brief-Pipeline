{
  "openapi": "3.1.0",
  "info": {
    "title": "SEO Briefing Pipeline API",
    "description": "\n    ## Automated SEO Content Briefing Generation\n    \n    Generate comprehensive SEO content briefs using:\n    - **SEMrush** - Keyword research and search volume data\n    - **SerpAPI** - Real-time SERP analysis\n    - **OpenAI GPT-4** - AI-powered content recommendations\n    - **Google Search Console** - Cannibalization detection\n    \n    ### Features\n    - Automated keyword research\n    - Competitor content analysis\n    - AI-generated briefings with structured headings\n    - Google Sheets integration\n    - Rate-limited API (10 requests/minute)\n    \n    ### Authentication\n    All endpoints (except `/health`) require an `X-API-Key` header.\n    \n    ### Rate Limiting\n    - **Limit**: 10 requests per minute per IP\n    - **Exempt**: `/health`, `/docs`, `/openapi.json`\n    ",
    "contact": {
      "name": "SEO Pipeline Support",
      "url": "https://github.com/your-repo/seo-pipeline",
      "email": "support@example.com"
    },
    "license": {
      "name": "MIT",
      "url": "https://opensource.org/licenses/MIT"
    },
    "version": "2025.11.18"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Health Check",
        "description": "Check API health status and active configuration",
        "operationId": "health_check_health_get",
        "responses": {
          "200": {
            "description": "System health status",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/briefing": {
      "post": {
        "tags": [
          "briefing"
        ],
        "summary": "Create SEO Briefing",
        "description": "Generate a comprehensive SEO content brief for a given keyword.\n    \n    This endpoint:\n    1. Fetches keyword data from SEMrush\n    2. Analyzes SERP results via SerpAPI\n    3. Audits top competitor content\n    4. Checks for keyword cannibalization (if GSC configured)\n    5. Generates AI-powered content brief with OpenAI\n    6. Exports results in multiple formats (JSON, Markdown, XLSX)\n    7. Optionally uploads to Google Sheets\n    \n    **Note**: This is a long-running operation executed in the background.\n    Use the `/briefing/{run_id}` endpoint to check status.",
        "operationId": "create_briefing_briefing_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BriefingRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Briefing creation initiated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BriefingResponse"
                },
                "example": {
                  "run_id": "20251125_120530",
                  "keyword": "content marketing",
                  "output_dir": "outputs/20251125_120530",
                  "files": {
                    "status": "/outputs/20251125_120530/status.json"
                  }
                }
              }
            }
          },
          "400": {
            "description": "No client/project configured"
          },
          "403": {
            "description": "Invalid or missing API key"
          },
          "429": {
            "description": "Rate limit exceeded"
          },
          "500": {
            "description": "Internal server error"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ]
      }
    },
    "/briefing/{run_id}": {
      "get": {
        "tags": [
          "briefing"
        ],
        "summary": "Get Briefing Status",
        "description": "Check the status of a running or completed briefing generation task.\n    \n    Poll this endpoint to track progress of the briefing generation.\n    \n    **Status values**:\n    - `queued` - Task is waiting to start\n    - `running` - Task is in progress\n    - `done` - Task completed successfully\n    - `failed` - Task encountered an error",
        "operationId": "briefing_status_briefing__run_id__get",
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Run Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Status retrieved successfully",
            "content": {
              "application/json": {
                "schema": {},
                "examples": {
                  "running": {
                    "value": {
                      "status": "running",
                      "step": "3/8 Auditando competidores...",
                      "message": "Processing"
                    }
                  },
                  "completed": {
                    "value": {
                      "status": "done",
                      "step": "completed",
                      "message": "Pipeline completado",
                      "files": {
                        "json": "/outputs/20251125_120530/briefing.json",
                        "markdown": "/outputs/20251125_120530/briefing.md"
                      }
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Run ID not found"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
