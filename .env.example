# ============================================================================
# SEO Brief Pipeline - Environment Configuration
# ============================================================================
# IMPORTANT: Never commit .env to version control!
# This file (.env.example) shows the template. Copy to .env and fill with real values.
#
# Setup: cp .env.example .env
#        Then edit .env with your API keys and credentials
# ============================================================================

# ============================================================================
# REQUIRED: Vendor APIs & Credentials
# ============================================================================

# Semrush API Token
# Get from: https://www.semrush.com/user/settings/api/ → API Units
# Keep real values only in local .env.
SEMRUSH_TOKEN=replace-with-your-semrush-token

# SerpAPI Key
# Get from: https://serpapi.com/dashboard → API Key
# Keep real values only in local .env.
SERPAPI_KEY=replace-with-your-serpapi-key

# OpenAI API Key
# Get from: https://platform.openai.com/account/api-keys
# SECURITY WARNING: Never hardcode or commit this. Use .env only.
# Keep real values only in local .env.
OPENAI_API_KEY=replace-with-your-openai-key

# Optional: Piloterr API Key (if using Piloterr data source)
# Get from: https://piloterr.com/api
PILOTERR_API_KEY=e8fe8d85-7969-41ef-806d-4cd7caa9866d

# Optional: DataForSEO Credentials
# Get from: https://dataforseo.com/account/credentials
DFSP_USERNAME=your_dataforseo_email@example.com
DFSP_PASSWORD=your_dataforseo_password

# ============================================================================
# REQUIRED: FastAPI & Server Security
# ============================================================================

# API Key for FastAPI authentication (X-API-Key header)
# Generate a strong one: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Must be >= 20 characters for security
API_KEY=your_strong_api_key_of_at_least_20_chars_here

# ============================================================================
# OPTIONAL: Monitoring & Observability
# ============================================================================

# Sentry Error Monitoring (for production environments)
# Get from: https://sentry.io → Create project → DSN
# Leave blank to disable Sentry
SENTRY_DSN=

# Sentry Environment (development, staging, production)
SENTRY_ENVIRONMENT=development

# Sentry Release Version (to track which release has errors)
SENTRY_RELEASE=2025.12.11

# ============================================================================
# OPTIONAL: Pipeline Configuration
# ============================================================================

# Root directory for pipeline data (defaults to current working directory)
# Useful if running from different locations
# PIPELINE_ROOT=/path/to/seo-pipeline

# ============================================================================
# GOOGLE CLOUD & SERVICE ACCOUNTS
# ============================================================================
# For GSC (Google Search Console) and Google Sheets integration, place your
# Service Account JSON files in the credentials/ folder:
#   - credentials/client_secret.json     (OAuth for GCS/Sheets)
#   - credentials/token_gsc.json         (cached token)
#
# See TUTORIALS.md for setup instructions
# ============================================================================
